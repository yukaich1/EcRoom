    "researcher",
    "norm_steward",
    "strategist",
    "draft_writer",
    "editor",
    "critic_panel"
  ],
  "workflow_steps": [
    "识别目标平台、受众、发布目的和必须保留的信息。",
    "召回平台表达习惯、风险边界和用户历史偏好。",
    "生成一个主版本和必要的平台变体，不把规则解释写进正文。",
