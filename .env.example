# EcRoom example environment file.
# Copy this file to .env, then fill in the provider you want to use.
# Leaving keys empty is fine: EcRoom can run with the local stub flow.

ECR_LLM_PROVIDER=stub
ECR_LLM_MODEL=
ECR_LLM_BASE_URL=

# Mistral
MISTRAL_API_KEY=

# OpenAI
OPENAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Memory retrieval
ECROOM_VECTOR_BACKEND=chroma
