  ],
  "evaluation": [
    "平台贴合度",
    "核心信息保留",
    "自然度",
    "规范安全"
  ],
  "examples": [
    "同一个角色内容，分别改成微博和小红书版本。"
  ],
  "failure_policy": [
    "平台不明确时生成通用版，并标注可适配方向。"
  ],
